# Kitchen kiosk (read-only Wochenübersicht display) — live Lenovo paths.

[Unit]
Description=Catering kitchen kiosk (read-only)
After=network.target

[Service]
Type=simple
User=viktor
WorkingDirectory=/home/viktor/projects/silberloeffel-catering
Environment=PYTHONPATH=/home/viktor/projects/silberloeffel-catering/src
ExecStart=/usr/bin/python3 -m catering_system.ui.kiosk_server --db /home/viktor/catering-runtime/core.db --port 8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
