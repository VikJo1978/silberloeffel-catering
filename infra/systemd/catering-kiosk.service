# Kitchen kiosk (read-only Wochenübersicht display) — install per DEPLOYMENT.md §1b.
# Replace /opt/catering with the actual repo path and 'catering' with the actual user.

[Unit]
Description=Catering kitchen kiosk (read-only)
After=network.target

[Service]
Type=simple
User=catering
WorkingDirectory=/opt/catering
Environment=PYTHONPATH=/opt/catering/src
ExecStart=/usr/bin/python3 -m catering_system.ui.kiosk_server --db /var/lib/catering/core.db --port 8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
