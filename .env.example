# Local development reference only. Never put real production values here.

OFFICE_PANEL_PASSWORD=change-me-locally
# Safe rollout switch: only the Arbeitszentrale changes in v2.
OFFICE_UI_VERSION=legacy
WEBSITE_INTAKE_TOKEN=replace-with-local-test-token

# Optional read-only callback integration.
AUERSWALD_SYNC_URL=
AUERSWALD_SYNC_USER=
AUERSWALD_SYNC_PASSWORD=

# Optional link from office panel to the separate kiosk.
KIOSK_URL=http://127.0.0.1:8082

# Optional read-only Inquiry prefill handoff to the separate offer configurator.
CONFIGURATOR_URL=

# Cloudflare Worker bindings are configured in Cloudflare, not loaded by Python.
UPSTREAM_URL=
UPSTREAM_TOKEN=

# Kiosk pickup signal (dormant unless BOTH are set; token never via CLI).
PICKUP_SIGNAL_URL=
PICKUP_SIGNAL_TOKEN=

# Core Office API (Phase 1, dormant until the panel is configured against it).
OFFICE_API_TOKEN=

# Office panel Phase 2 dual mode: leave both empty for direct mode (opens
# core.db locally, unchanged). Set BOTH together to run the panel against the
# Core Office API instead — it then never opens core.db. Half-configured
# (only one set) refuses to start. CORE_OFFICE_API_TOKEN is env-only, never a
# CLI flag.
CORE_OFFICE_API_URL=
CORE_OFFICE_API_TOKEN=

# Offer/Confirmation PDF static content (issue #41): required in direct mode
# for both the Core Office API and the Office Panel — validated before
# core.db is ever opened; refuses to start if any required value is missing
# or blank. Free-text format unless noted; never invent production wording
# here, these are placeholders only.

# Required.
OFFICE_PDF_COMPANY_LEGAL_NAME=Musterfirma GmbH
# Pipe-separated address lines, e.g. "Straße 1|20095 Hamburg".
OFFICE_PDF_COMPANY_ADDRESS_LINES=Musterstraße 1|20095 Hamburg
OFFICE_PDF_ACCEPTANCE_STATEMENT=Mit der Bestätigung dieses Angebots kommt der Auftrag zustande.

# Optional.
# Absolute path to a readable logo image file; unset skips the logo. A
# missing or unreadable path refuses to start rather than skipping silently.
OFFICE_PDF_LOGO_PATH=
OFFICE_PDF_COMPANY_PHONE=
OFFICE_PDF_COMPANY_EMAIL=
OFFICE_PDF_COMPANY_WEB=
OFFICE_PDF_COMPANY_REGISTER_TEXT=
OFFICE_PDF_COMPANY_VAT_ID_TEXT=
OFFICE_PDF_FOOTER_NOTE=
OFFICE_PDF_BANK_DETAILS_TEXT=
